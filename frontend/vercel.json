{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npx ng build && sed -i \"s#__LEDGERLENS_WS_BASE__#${LEDGERLENS_WS_BASE}#\" dist/frontend/browser/index.html",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ledgerlens-gateway.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
