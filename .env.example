# Copy to .env (gitignored). docker-compose reads it automatically.
GEN_RATE_PER_SEC=20
LOG_LEVEL=INFO
# Local-only Mongo root credentials for docker-compose. In Kubernetes these come from a Secret.
MONGO_ROOT_USER=ledgerlens
MONGO_ROOT_PASSWORD=change-me-local
# Gateway JWT signing key (HS256, use >= 32 random bytes: `openssl rand -hex 32`). In Kubernetes: a Secret.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Local-only Couchbase admin credentials (risk service profiles).
COUCHBASE_USER=Administrator
COUCHBASE_PASSWORD=change-me-local
# Risk rule thresholds (defaults shown; invalid values stop the risk service at startup).
# RISK_FLAG_THRESHOLD=50
# RISK_VELOCITY_WINDOW_S=20
# RISK_VELOCITY_MAX_TXNS=5
# RISK_ZSCORE_THRESHOLD=3.5
# RISK_COUNTRY_WINDOW_S=7200
# Query agent LLM (optional). Without a key the agent uses the deterministic catalog planner.
# AGENT_MODEL=gemini-flash-latest   # or a Claude model id, or openai/gpt-4o-mini (via LiteLLM)
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# MongoDB Atlas (cloud demo / Render). Quote it: the URI contains '&'.
# MONGO_ATLAS_URI='mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority'
